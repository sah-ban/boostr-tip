generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  fid             String      @unique
  username        String?
  displayName     String?
  pfpUrl          String?
  walletAddresses String[]
  isAllowanceEnabled Boolean  @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  allTimePoints   Decimal     @default(0)

  tipsSent        Tip[]       @relation("TipSender")
  tipsReceived    Tip[]       @relation("TipRecipient")
  allowances      Allowance[]
  points          Points[]
}

model Tip {
  id             String    @id @default(cuid())
  castHash       String
  senderFid      String
  recipientFid   String
  amount         Decimal
  status         TipStatus @default(valid)
  snapshotDay    DateTime
  createdAt      DateTime  @default(now())

  sender         User      @relation("TipSender", fields: [senderFid], references: [fid])
  recipient      User      @relation("TipRecipient", fields: [recipientFid], references: [fid])

  @@index([senderFid])
  @@index([recipientFid])
  @@index([snapshotDay])
}

model Allowance {
  id                  String   @id @default(cuid())
  userFid             String
  snapshotDay         DateTime
  userRank            Int?
  tipAllowance        Decimal
  remainingAllowance  Decimal
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userFid], references: [fid])

  @@unique([userFid, snapshotDay])
  @@index([snapshotDay])
}

model Points {
  id              String   @id @default(cuid())
  userFid         String
  points          Decimal  @default(0)
  leaderboardRank Int?
  snapshotDay     DateTime
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userFid], references: [fid])

  @@unique([userFid, snapshotDay])
  @@index([snapshotDay])
}

enum TipStatus {
  valid
  invalid
}
